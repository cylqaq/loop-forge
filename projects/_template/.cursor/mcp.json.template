{
  "mcpServers": {
    "github-readonly": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub 只读：Issues/PR/Actions。写操作须人工审批。见 docs/ops/mcp-github-triage.md"
    },
    "github-draft": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN_WRITE}"
      },
      "description": "阶段 3 半自动：Draft PR 写 scope。默认禁用 — 须用户显式启用并配置 GITHUB_TOKEN_WRITE。见 docs/ops/mcp-pr-draft-flow.md"
    }
  }
}
