{
  "name": "loop-forge",
  "version": "0.8.0",
  "private": true,
  "description": "Loop Engineering 母版模板 — 收集 AI 协作智慧，孵化任意具体项目",
  "type": "module",
  "scripts": {
    "loop": "node harness/scripts/loop.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke:all": "node harness/scripts/smoke-all.mjs",
    "smoke:state-machine": "node harness/scripts/smoke-state-machine.mjs",
    "smoke:capabilities": "node harness/scripts/smoke-project-capabilities.mjs",
    "smoke:init": "node harness/scripts/smoke-init.mjs",
    "smoke:ci-fix": "node harness/scripts/smoke-ci-fix.mjs",
    "smoke:scaffold": "node harness/scripts/smoke-scaffold-project.mjs",
    "smoke:external": "node harness/scripts/smoke-external-init.mjs",
    "smoke:pr-draft": "node harness/scripts/smoke-pr-draft.mjs --dry-run",
    "smoke:adopt": "node harness/scripts/smoke-adopt.mjs",
    "smoke:cloud-loop": "node harness/scripts/smoke-cloud-loop.mjs",
    "cloud-loop": "node scripts/cloud-loop.mjs",
    "sync-template": "node harness/scripts/sync-template.mjs",
    "doctor": "node harness/scripts/loop.mjs doctor",
