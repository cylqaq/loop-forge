# 环境变量示例（复制为 .env，勿提交）

# GitHub 只读 Token — 用于 MCP github-readonly
GITHUB_TOKEN=

# 可选：指定 triage 目标仓库
GITHUB_TRIAGE_REPO=cylqaq/loop-forge

# 阶段 3 Draft PR（可选，须显式启用 github-draft MCP）
GITHUB_TOKEN_WRITE=

# --- L4 Cursor SDK（Round 7 完整落地）---
# LOOP_CLOUD_ENABLED=false
# CURSOR_API_KEY=
# CURSOR_AGENT_MODEL=composer-2.5-fast
# CURSOR_CLOUD_RUNTIME=local
